  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget { background-color: #f4f4f4; }
QFrame#scoreFrame, QFrame#historyFrame, QFrame#actionFrame, QFrame#settingsFrame, QFrame#gateway1Frame, QFrame#gateway2Frame, QFrame#predictionFrame { background-color: #111111; border: 1px solid #f4f4f4; }
QLabel { color: white; }
QLabel#lblTitle { color: #222222; font-size: 22px; font-weight: 700; }
QLabel#lblScore { background-color: #4b78c6; color: white; font-size: 28px; font-weight: 700; padding: 14px; border-radius: 2px; }
QLabel#lblGateway1Title, QLabel#lblGateway2Title, QLabel#lblPredictionTitle { background-color: #4b78c6; color: white; font-size: 22px; font-weight: 700; padding: 10px 18px; }
QLabel#lblPredictionTitle { font-size: 16px; padding: 4px 8px; }
QLabel#lblGateway1, QLabel#lblGateway2 { color: white; font-size: 18px; }
QLabel#lblVoltageValue, QLabel#lblCurrentValue { background-color: #4b78c6; color: white; font-size: 28px; font-weight: 700; padding: 8px 28px; }
QLabel#lblPrediction { background-color: #4b78c6; color: white; font-size: 24px; font-weight: 700; padding: 12px 28px; }
QLabel#lblStatus { background-color: #72b447; color: white; font-size: 18px; font-weight: 700; padding: 8px 14px; }
QPushButton { background-color: #4b78c6; color: white; border: none; min-height: 48px; font-size: 20px; font-weight: 700; padding: 4px 14px; }
QPushButton:hover { background-color: #5b87d2; }
QPushButton:disabled { color: white; }
QTableWidget { background-color: #111111; color: white; gridline-color: #444444; border: none; font-size: 16px; }
QHeaderView::section { background-color: #333333; color: white; padding: 7px; border: 1px solid #555555; font-weight: 700; }
QTableCornerButton::section { background-color: #333333; border: 1px solid #555555; }</string>
